<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">

    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>{% block title %}HSP Chat - Communication Hospitalière{% endblock %}</title>
    <meta name="description" content="">
    <meta name="keywords" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- =======================================================
    * Template Name: Clinic
    * Template URL: https://bootstrapmade.com/clinic-bootstrap-template/
    * Updated: Jul 23 2025 with Bootstrap v5.3.7
    * Author: BootstrapMade.com
    * License: https://bootstrapmade.com/license/
    ======================================================== -->

    {# AOS - Animate On Scroll CSS #}
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    {# PureCounter CSS non nécessaire (pur JS) #}

    {% block stylesheets %}

        <!-- Favicons -->
        <link href="{{ asset("img/favicon.png") }}" rel="icon">
        <link href="{{ asset("img/apple-touch-icon.png") }}" rel="apple-touch-icon">

        <!-- Fonts -->
        <link href="https://fonts.googleapis.com" rel="preconnect">
        <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">

        <!-- Vendor CSS Files -->
        <link href="{{ asset("vendor/bootstrap/css/bootstrap.min.css") }}" rel="stylesheet">
        <link href="{{ asset("vendor/bootstrap-icons/bootstrap-icons.css") }}" rel="stylesheet">
        <link href="{{ asset("vendor/aos/aos.css") }}" rel="stylesheet">
        <link href="{{ asset("vendor/glightbox/css/glightbox.min.css") }}" rel="stylesheet">
        <link href="{{ asset("vendor/fontawesome-free/css/all.min.css") }}" rel="stylesheet">
        <link href="{{ asset("vendor/swiper/swiper-bundle.min.css") }}" rel="stylesheet">

        <!-- Main CSS File -->
        <link href="{{ asset("css/main.css") }}" rel="stylesheet">
    {% endblock %}

    {% block javascripts %}
        <!-- Vendor JS Files -->
        <script src="{{ asset("vendor/bootstrap/js/bootstrap.bundle.min.js") }}"></script>
        <script src="{{ asset("vendor/php-email-form/validate.js") }}"></script>
        <script src="{{ asset("vendor/aos/aos.js") }}"></script>
        <script src="{{ asset("vendor/glightbox/js/glightbox.min.js") }}"></script>
        <script src="{{ asset("vendor/purecounter/purecounter_vanilla.js") }}"></script>
        <script src="{{ asset("vendor/swiper/swiper-bundle.min.js") }}"></script>

        <!-- Main JS File -->
        <script src="{{ asset("js/main.js") }}"></script>


        {# PureCounter.js #}
        <script src="https://cdn.jsdelivr.net/npm/purecounterjs@1.5.0/dist/purecounter_vanilla.js"></script>

        {# AOS.js #}
        <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

        <script>
            // Initialisation des librairies après chargement
            document.addEventListener('DOMContentLoaded', function () {
                // Init AOS
                AOS.init({
                    duration: 600,
                    easing: 'ease-in-out',
                    once: true,
                    mirror: false
                });

                // Init PureCounter
                new PureCounter();
            });
        </script>
    {% endblock %}
</head>


<body style="padding-top: 112px">
{% block body %}


    <header id="header" class="header fixed-top">

        <div class="topbar d-flex align-items-center dark-background">
            <div class="container d-flex justify-content-center justify-content-md-between">
                <div class="contact-info d-flex align-items-center">
                    <i class="bi bi-envelope d-flex align-items-center"><a href="mailto:contact@example.com">contact@example.com</a></i>
                    <i class="bi bi-phone d-flex align-items-center ms-4"><span>+1 5589 55488 55</span></i>
                </div>
                <div class="social-links d-none d-md-flex align-items-center">
                    <a href="https://github.com/Nico180803/HSP-projet-SLAM-2"><i class="bi-github"></i></a>

                </div>
            </div>
        </div><!-- End Top Bar -->

        <div class="branding d-flex align-items-cente">

            <div class="container position-relative d-flex align-items-center justify-content-between">
                <a href="{{ path('app_home') }}" class="logo d-flex align-items-center">
                    <!-- Uncomment the line below if you also wish to use an image logo -->
                    <!-- <img src="assets/img/logo.webp" alt=""> -->
                    <h1 class="sitename">HSP</h1>
                </a>

                <nav id="navmenu" class="navmenu">
                    <ul>
                        <li><a href="{{ path('app_home') }}" class="active">Accueil</a></li>
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <li class="dropdown"><a href="#"><span>Forum</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                                <ul>
                                    {% for forumU in forum %}

                                        {% if app.user.roles.0 == 'ROLE_ADMIN' %}
                                            <li><a href="{{ path('app_flux_show', { id:  forumU.id  }) }}">{{ forumU.titre }}</a></li>
                                        {% elseif forumU.id == 1 %}
                                            <li><a href="{{ path('app_flux_show', { id:  forumU.id  }) }}">{{ forumU.titre }}</a></li>

                                        {% elseif forumU.role.0 == app.user.roles.0 %}
                                            <li><a href="{{ path('app_flux_show', { id:  forumU.id  }) }}">{{ forumU.titre }}</a></li>

                                        {% elseif forumU.role.0 == app.user.roles.0 %}
                                            <li><a href="{{ path('app_flux_show', { id:  forumU.id  }) }}">{{ forumU.titre }}</a></li>
                                        {% endif %}


                                    {% endfor %}
                                </ul>
                            </li>
                        {% endif %}
                        {# faire si connecter = acces profil #}
                        <li class="dropdown"><a href="#"><span>Compte</span> <i class="bi bi-chevron-down toggle-dropdown"></i></a>
                            <ul>
                                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                                    <li><a href="{{ path('app_user_show', {'id': app.user.id}) }}">Profil</a></li>
                                    <li><a href="{{ path('app_logout') }}">Se déconnecter</a></li>

                                {% else %}
                                    <li><a href="{{ path('app_register') }}">Inscription</a></li>
                                    <li><a href="{{ path('app_login') }}">Connexion</a></li>
                                {% endif %}
                            </ul>
                        </li>




                    </ul>
                    <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
                </nav>

            </div>

        </div>

    </header>
{% endblock %}

</body>

</html>
