{# templates/admin/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Tableau de bord admin{% endblock %}

{% block body %}


    {{ parent() }}

    <div class="container-fluid py-4">

        {# HEADER + CTA #}
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1">Tableau de bord administrateur</h1>
                <p class="text-muted mb-0">
                    Vue globale des événements, du forum et des profils utilisateurs.
                </p>
            </div>

        </div>

        {# ROW: EVENTS + FORUM #}
        <div class="row g-3 mb-4">

            {# PROCHAINS ÉVÉNEMENTS #}
            <div class="col-12 col-xl-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-0 fw-bold">
                                Prochains évènements
                            </h2>
                            <small class="text-muted">Les 5 prochains</small>
                        </div>
                        <a href="{{ path('app_evenements_index') }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-calendar-event me-1"></i> Tous les évènements
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="text-muted small">
                            <tr>
                                <th>Titre</th>
                                <th>Date</th>
                                <th>Lieu</th>
                                <th class="text-end">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for evenement in evenements %}
                                <tr>
                                    <td class="fw-semibold">
                                        {{ evenement.titre }}
                                    </td>
                                    <td>
                                    <span class="badge bg-light text-dark border">
                                        {{ evenement.dateDebut|date('d/m/Y') }} - {{ evenement.dateFin|date('d/m/Y') }}
                                    </span>
                                    </td>
                                    <td class="text-muted small">
                                        {{ evenement.nbPlacesDispo }}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('app_evenements_show', {id: evenement.id}) }}"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="{{ path('app_evenements_delete', {id: evenement.id}) }}"
                                           class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Supprimer cet utilisateur ?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        Aucun évènement à venir.
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer bg-white border-0 text-end">
                        <a href="{{ path('app_evenements_new') }}" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Créer un évènement
                        </a>
                    </div>
                </div>
            </div>

            {# ACTIVITÉ FORUM RÉCENTE #}
            <div class="col-12 col-xl-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-0 fw-bold">Activité récente du forum</h2>
                            <small class="text-muted">Derniers messages</small>
                        </div>

                        <a  href="{{ path('app_flux_index') }}"  class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-chat-right-text me-1"></i> Tous les Forums
                        </a>
                    </div>

                    <ul class="list-group list-group-flush">
                        {% for post in sujets %}
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <div class="me-3">
                                        <div class="d-flex align-items-center">
                                            <span class="fw-semibold">{{ post.titre }}</span>
                                        </div>
                                        <div class="small text-muted">
                                            <span class="fw-semibold">{{ post.message }}</span>
                                        </div>
                                    </div>

                                    <div class="text-end small text-muted">
                                        <div class="mt-2 d-flex flex-column gap-1">
                                            <a href="{{ path('app_flux_show', {id: post.id}) }}"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="{{ path('app_flux_show', {id: post.id}) }}"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="return confirm('Supprimer ce message ?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        {% else %}
                            <li class="list-group-item text-center text-muted py-4">
                                Aucune activité récente sur le forum.
                            </li>
                        {% endfor %}
                    </ul>

                </div>
            </div>

        </div>

        {# UTILISATEURS RÉCENTS / GESTION PROFILS #}
        <div class="row g-3">

            <div class="col-12 col-xl-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-0 fw-bold">Nouveaux profils</h2>
                            <small class="text-muted">Les derniers inscrits</small>
                        </div>

                        <a href="{{ path('app_user_index') }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-people me-1"></i> Tous les utilisateurs
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="text-muted small">
                            <tr>
                                <th>Utilisateur</th>
                                <th>Rôle</th>
                                <th>Inscription</th>
                                <th class="text-end">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for user in users %}
                                <tr>
                                    <td class="fw-semibold">{{ user.nom }}  {{ user.prenom }}</td>
                                    <td>
                                        {% for role in user.roles %}
                                        <span class="badge bg-light text-dark border">{{ role }}</span>
                                        {% endfor %}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('app_user_show', {id: user.id}) }}"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-person"></i>
                                        </a>
                                        <a href="{{ path('app_user_edit', {id: user.id}) }}"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="{{ path('app_user_delete', {id: user.id}) }}"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Supprimer cet utilisateur ?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        Personne ne s'est inscrit récemment.
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer bg-white border-0 text-end">
                        <a href="{{ path('app_user_new') }}" class="btn btn-primary btn-sm">
                            <i class="bi bi-person-plus me-1"></i> Créer un profil
                        </a>
                    </div>
                </div>
            </div>




    </div>
{% endblock %}
