{# templates/admin/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Tableau de bord admin{% endblock %}

{% block body %}
    {{ parent() }}

    <div class="container-fluid py-4">

        {# HEADER + CTA #}
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1">Tableau de bord administrateur</h1>
                <p class="text-muted mb-0">
                    Vue globale des événements, du forum et des profils utilisateurs.
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-3 mt-md-0">
                <a href="{{ path('app_evenements_index') }}" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Les Évènements
                </a>

                <a href="{{ path('app_flux_new') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-chat-dots me-1"></i> Les Forums
                </a>

                <a href="{{ path('app_user_index') }}" class="btn btn-outline-dark btn-sm">
                    <i class="bi bi-people me-1"></i> Gérer les profils
                </a>
            </div>
        </div>

        {# KPI CARDS #}
        <div class="row g-3 mb-4">

            {# KPI 1 : nb évènements à venir #}
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="text-muted text-uppercase small fw-semibold">Évènements à venir</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                            +{{ upcomingEventsGrowthPercent ?? 12 }}%
                        </span>
                        </div>

                        <div class="d-flex align-items-baseline">
                        <span class="display-6 fw-bold me-2">
                            {{ upcomingEventsCount ?? 5 }}
                        </span>
                            <span class="text-muted">planifiés</span>
                        </div>

                        <div class="mt-3 d-flex justify-content-between small text-muted">
                            <span>Cette semaine</span>
                            <a href="{{ path('app_evenements_index') }}" class="text-decoration-none">Voir tout →</a>
                        </div>
                    </div>
                </div>
            </div>

            {# KPI 2 : activité forum #}
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="text-muted text-uppercase small fw-semibold">Activité forum</span>
                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">
                            {{ newPostsLast24h ?? 8 }} nouveaux /24h
                        </span>
                        </div>

                        <div class="d-flex align-items-baseline">
                        <span class="display-6 fw-bold me-2">
                            {{ forumMessagesCount ?? 142 }}
                        </span>
                            <span class="text-muted">messages</span>
                        </div>

                        <div class="mt-3 d-flex justify-content-between small text-muted">
                            <span>{{ forumTopicsCount ?? 27 }} sujets actifs</span>
                            <a href="{{ path('app_flux_new') }}" class="text-decoration-none">
                                Modérer →
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {# KPI 3 : utilisateurs actifs #}
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="text-muted text-uppercase small fw-semibold">Utilisateurs actifs</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                            {{ activeRate ?? 64 }}% actifs
                        </span>
                        </div>

                        <div class="d-flex align-items-baseline">
                        <span class="display-6 fw-bold me-2">
                            {{ activeUsers ?? 89 }}
                        </span>
                            <span class="text-muted">/ {{ totalUsers ?? 112 }}</span>
                        </div>

                        <div class="mt-3 d-flex justify-content-between small text-muted">
                            <span>sur les 7 derniers jours</span>
                            <a href="{{ path('app_user_index') }}" class="text-decoration-none">
                                Gérer →
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {# KPI 4 : alertes / signalements #}
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="text-muted text-uppercase small fw-semibold">Signalements</span>
                            {% if reportsCount is defined and reportsCount > 0 %}
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">
                                {{ reportsCount }} à traiter
                            </span>
                            {% else %}
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                OK
                            </span>
                            {% endif %}
                        </div>

                        <div class="d-flex align-items-baseline">
                        <span class="display-6 fw-bold me-2">
                            {{ reportsCount ?? 2 }}
                        </span>
                            <span class="text-muted">contenus signalés</span>
                        </div>

                        <div class="mt-3 d-flex justify-content-between small text-muted">
                            <span>dernières 48h</span>
                            <a {# href="{{ path('admin_reports') }}"#} class="text-decoration-none">
                                Traiter →
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        {# ROW: EVENTS + FORUM #}
        <div class="row g-3 mb-4">

            {# PROCHAINS ÉVÉNEMENTS #}
            <div class="col-12 col-xl-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-0 fw-bold">
                                Prochains évènements
                            </h2>
                            <small class="text-muted">Les 5 prochains</small>
                        </div>
                        <a href="{{ path('app_evenements_index') }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-calendar-event me-1"></i> Tous les évènements
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="text-muted small">
                            <tr>
                                <th>Titre</th>
                                <th>Date</th>
                                <th>Lieu</th>
                                <th class="text-end">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for event in upcomingEvents ?? [
                                {title:'Atelier sécurité', date:'2025-11-03 14:00', place:'Salle B12', id:1},
                                {title:'Réunion parents/profs', date:'2025-11-05 18:30', place:'Amphi A', id:2},
                                {title:'Forum des métiers', date:'2025-11-10 09:00', place:'Hall principal', id:3}
                            ] %}
                                <tr>
                                    <td class="fw-semibold">
                                        {{ event.title }}
                                    </td>
                                    <td>
                                    <span class="badge bg-light text-dark border">
                                        {{ event.date }}
                                    </span>
                                    </td>
                                    <td class="text-muted small">
                                        {{ event.place }}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('app_evenements_show', {id: event.id}) }}"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="{{ path('app_evenements_delete', {id: event.id}) }}"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Supprimer cet évènement ?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        Aucun évènement à venir.
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer bg-white border-0 text-end">
                        <a href="{{ path('app_evenements_new') }}" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle me-1"></i> Créer un évènement
                        </a>
                    </div>
                </div>
            </div>

            {# ACTIVITÉ FORUM RÉCENTE #}
            <div class="col-12 col-xl-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-0 fw-bold">Activité récente du forum</h2>
                            <small class="text-muted">Derniers messages</small>
                        </div>

                        <a {# href="{{ path('') }}" #} class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-shield-check me-1"></i> Modération
                        </a>
                    </div>

                    <ul class="list-group list-group-flush">
                        {% for post in lastForumPosts ?? [
                            {
                                author:'amelie.d',
                                topic:'[INFOS STAGE] Convention à rendre ?',
                                excerpt:'Bonjour, est-ce qu’on doit rendre la convention signée avant le 15...',
                                createdAt:'il y a 2h',
                                flagged:false,
                                id:10
                            },
                            {
                                author:'kylian.m',
                                topic:'Sortie pédagogique à Paris',
                                excerpt:'Je voulais savoir si le départ se fait bien à 7h15 devant le lycée ?',
                                createdAt:'il y a 5h',
                                flagged:true,
                                id:11
                            }
                        ] %}
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between">
                                    <div class="me-3">
                                        <div class="d-flex align-items-center">
                                            <span class="fw-semibold">{{ post.author }}</span>
                                            {% if post.flagged %}
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-2">
                                                Signalé
                                            </span>
                                            {% endif %}
                                        </div>
                                        <div class="small text-muted">
                                            dans <span class="fw-semibold">{{ post.topic }}</span>
                                        </div>
                                        <div class="small text-body mt-1">
                                            {{ post.excerpt }}
                                        </div>
                                    </div>

                                    <div class="text-end small text-muted">
                                        <div>{{ post.createdAt }}</div>
                                        <div class="mt-2 d-flex flex-column gap-1">
                                            <a href="{{ path('app_flux_show', {id: post.id}) }}"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="{{ path('app_flux_show', {id: post.id}) }}"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="return confirm('Supprimer ce message ?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        {% else %}
                            <li class="list-group-item text-center text-muted py-4">
                                Aucune activité récente sur le forum.
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="card-footer bg-white border-0 text-end">
                        <a {# href="{{ path('app_flux_show') }}" #} class="btn btn-outline-dark btn-sm">
                            <i class="bi bi-chat-right-text me-1"></i> Tous les sujets
                        </a>
                    </div>
                </div>
            </div>

        </div>

        {# UTILISATEURS RÉCENTS / GESTION PROFILS #}
        <div class="row g-3">

            <div class="col-12 col-xl-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-0 fw-bold">Nouveaux profils</h2>
                            <small class="text-muted">Les derniers inscrits</small>
                        </div>

                        <a href="{{ path('app_user_index') }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-people me-1"></i> Tous les utilisateurs
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="text-muted small">
                            <tr>
                                <th>Utilisateur</th>
                                <th>Rôle</th>
                                <th>Inscription</th>
                                <th class="text-end">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for user in lastUsers ?? [
                                {username:'melissa.r', role:'Élève', joinedAt:'2025-10-26', id:50},
                                {username:'prof.mathieu', role:'Professeur', joinedAt:'2025-10-25', id:51},
                                {username:'cpe.admin', role:'Admin', joinedAt:'2025-10-24', id:52}
                            ] %}
                                <tr>
                                    <td class="fw-semibold">{{ user.username }}</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">{{ user.role }}</span>
                                    </td>
                                    <td class="text-muted small">{{ user.joinedAt }}</td>
                                    <td class="text-end">
                                        <a href="{{ path('app_user_show', {id: user.id}) }}"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-person"></i>
                                        </a>
                                        <a href="{{ path('app_user_edit', {id: user.id}) }}"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="{{ path('app_user_delete', {id: user.id}) }}"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Supprimer cet utilisateur ?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        Personne ne s'est inscrit récemment.
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer bg-white border-0 text-end">
                        <a href="{{ path('app_user_new') }}" class="btn btn-primary btn-sm">
                            <i class="bi bi-person-plus me-1"></i> Créer un profil
                        </a>
                    </div>
                </div>
            </div>

            {# BLOC RAPIDE MODÉRATION / ALERTES #}
            <div class="col-12 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0">
                        <h2 class="h6 mb-0 fw-bold">Actions rapides</h2>
                    </div>

                    <div class="list-group list-group-flush">
                        <a {#href="{{ path('admin_reports') }}"#} class="list-group-item list-group-item-action d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">Contenus signalés</div>
                                <small class="text-muted">Voir les messages à modérer</small>
                            </div>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">
                            {{ reportsCount ?? 2 }}
                        </span>
                        </a>

                        <a href="{{ path('app_evenements_new') }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">Publier un évènement</div>
                                <small class="text-muted">Annonce interne / sortie / réunion</small>
                            </div>
                            <i class="bi bi-calendar-plus fs-4"></i>
                        </a>

                        <a {#href="{{ path('admin_forum_moderation') }}"#} class="list-group-item list-group-item-action d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">Modération forum</div>
                                <small class="text-muted">Sujets sensibles, insultes, spam...</small>
                            </div>
                            <i class="bi bi-shield-lock fs-4"></i>
                        </a>

                        <a href="{{ path('app_user_index') }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">Gérer les rôles</div>
                                <small class="text-muted">Promouvoir / suspendre un compte</small>
                            </div>
                            <i class="bi bi-person-gear fs-4"></i>
                        </a>
                    </div>

                    <div class="card-footer bg-white border-0 small text-muted">
                        Dernière synchro rôles : {{ lastRoleSyncAt ?? '2025-10-27 09:42' }}
                    </div>
                </div>
            </div>

        </div>

    </div>
{% endblock %}
