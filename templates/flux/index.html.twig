{% extends 'base.html.twig' %}

{% block title %}Flux – Liste{% endblock %}

{% block body %}
    {{ parent() }}

    <!-- Section -->
    <section class="section py-5">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="section-title m-0">
                    <h2 class="mb-1">Flux</h2>
                    <p class="text-muted mb-0">Gérez vos flux d’actualités</p>
                </div>
                <a href="{{ path('app_flux_newFlux') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Nouveau flux
                </a>
            </div>

            {% if fluxes is empty %}
                <div class="card shadow-sm border-0" data-aos="fade-up" data-aos-delay="150">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-rss display-5 d-block mb-3"></i>
                        <h5 class="fw-semibold mb-2">Aucun flux pour le moment</h5>
                        <p class="text-muted">Créez votre premier flux pour alimenter le carrousel d’actualités.</p>
                        <a href="{{ path('app_flux_newFlux') }}" class="btn btn-primary mt-2">
                            <i class="bi bi-plus-circle me-1"></i> Créer un flux
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="card shadow-sm border-0" data-aos="fade-up" data-aos-delay="150">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                <tr>
                                    <th style="width: 90px;">ID</th>
                                    <th>Titre</th>
                                    <th style="width: 220px;" class="text-end">Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for flux in fluxes %}
                                    <tr>
                                        <td>
                      <span class="badge bg-secondary-subtle text-secondary-emphasis border">
                        #{{ flux.id }}
                      </span>
                                        </td>
                                        <td class="fw-semibold">{{ flux.titre }}</td>
                                        <td class="text-end">
                                            <div class="d-inline-flex align-items-center gap-2">
                                                <a href="{{ path('app_flux_edit', {'id': flux.id}) }}" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil-square me-1"></i> Modifier
                                                </a>

                                                <form method="post"
                                                      action="{{ path('app_flux_delete', {'id': flux.id}) }}"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Supprimer ce flux ? Cette action est irréversible.');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ flux.id) }}">
                                                    <button class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash3 me-1"></i> Supprimer
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
