{% extends 'base.html.twig' %}
{% block title %}{% endblock %}

{% block body %}
    {{ parent() }}
    <div class="min-h-screen flex flex-col">
        <link rel="stylesheet" href="{{ asset('css/styleForum.css') }}">
        <!-- Header -->
        <header class="bg-white shadow-md sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
                <!-- Logo / Navigation -->
            </div>
        </header>

        <!-- Main Content -->
        <div id="app">
            <main class="flex-1 py-8 bg-gray-50">
                <div class="max-w-4xl mx-auto px-6">

                    <!-- En-tête forum -->
                    <div class="bg-white rounded-2xl shadow-md mb-6">
                        <div class="p-6 border-b">
                            <h1 class="text-3xl font-bold text-blue-800 mb-2">Forum de Discussion, {{ flux.titre }}</h1>
                            <p class="text-gray-600">Échangez avec la communauté</p>
                            <form method="get" action="{{ path('app_flux_show', { id:  flux.id  }) }}" class="mb-4 d-flex" role="search">
                                <label>
                                    <input type="text" name="search" value="{{ app.request.get('search') }}" class="form-control me-2" placeholder="Rechercher un utilisateur...">
                                </label>
                                <button type="submit" class="btn btn-primary">Rechercher</button>
                            </form>
                        </div>

                        <div class="p-6">
                            <button @click="toggleNewTopicForm"
                                    class="bg-blue-700 text-white px-6 py-3 rounded font-medium hover:bg-blue-800 transition-colors">
                                [[ showNewTopicForm ? 'Fermer le formulaire' : 'Nouveau Sujet' ]]
                            </button>
                        </div>

                    </div>

                    <!-- Formulaire nouveau sujet -->
                    <div v-if="showNewTopicForm" class="bg-white rounded-2xl shadow-md mb-6">
                        <div class="p-6">
                            <h3 class="text-xl font-semibold text-gray-800 mb-4">Créer un nouveau sujet</h3>
                            <form class="space-y-4" @submit.prevent="publierSujet">
                                <div>
                                    <label for="topic-title" class="block text-sm font-medium text-gray-700 mb-2">Titre du sujet</label>
                                    <input type="text" id="topic-title" v-model="newTopic.titre"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                           placeholder="Entrez le titre de votre sujet">
                                </div>

                                <div>
                                    <label for="topic-content" class="block text-sm font-medium text-gray-700 mb-2">Message</label>
                                    <textarea id="topic-content" v-model="newTopic.message" rows="4"
                                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                              placeholder="Écrivez votre message..."></textarea>
                                </div>
                                <div class="flex space-x-4">
                                    <button type="submit"
                                            class="bg-blue-700 text-white px-6 py-2 rounded font-medium hover:bg-blue-800 transition-colors">
                                        Publier
                                    </button>
                                    <button type="button" @click="annulerSujet"
                                            class="border border-gray-300 text-gray-700 px-6 py-2 rounded font-medium hover:bg-gray-50 transition-colors">
                                        Annuler
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Liste des sujets -->
                    <div class="space-y-6">
                        {% for sujet in pagination %}
                            {% set idSujet = 'sujet_' ~ loop.index %}
                            <div class="topic-card bg-white rounded-2xl shadow-md" id="{{ idSujet }}">
                                <div class="topic-header p-6 border-b">
                                    <h2 class="topic-title text-xl font-semibold text-blue-800 mb-2">{{ sujet.titre }}</h2>
                                    <div class="topic-meta text-sm text-gray-600">
                                        Par {{ sujet.refUser }} • {{ sujet.commentaires|length }} réponses
                                    </div>
                                </div>

                                <div class="topic-content p-6 text-gray-700">
                                    {{ sujet.message }}
                                </div>

                                <div class="topic-actions p-4 bg-gray-50 border-t flex gap-4">
                                    <button @click="toggleReplyForm('{{ idSujet }}')" class="btn btn-outline btn-small">
                                        Répondre
                                    </button>
                                    <button @click="toggleReplies('{{ idSujet }}')" class="btn btn-outline btn-small">
                                        [[ repliesVisible['{{ idSujet }}'] ? 'Cacher les réponses' : 'Voir les réponses ({{ sujet.commentaires|length }})' ]]
                                    </button>
                                    {% if "ROLE_ADMIN" in app.user.roles %}
                                        {{ include('sujets/_delete_form.html.twig') }}
                                    {% elseif sujet.refUser == app.user %}
                                        {{ include('sujets/_delete_form.html.twig') }}
                                    {% endif %}
                                </div>

                                <!-- Section réponses -->
                                <div v-show="repliesVisible['{{ idSujet }}']" class="replies-section bg-gray-50 p-6 border-t">
                                    <h4 class="font-medium text-gray-800 mb-4">Réponses ({{ sujet.commentaires|length }})</h4>
                                    {% for commentaire in sujet.commentaires %}
                                        <div class="reply-card mb-4 bg-white border border-gray-200 rounded-lg p-4">
                                            <div class="flex justify-between items-start">
                                                <div>
                                                    <div class="reply-meta text-xs text-gray-600 mb-2">
                                                        <strong>par {{ commentaire.refUser }}</strong>
                                                    </div>
                                                    <div class="reply-content text-gray-700">
                                                        {{ commentaire.reponse }}
                                                    </div>
                                                </div>

                                                <div class="ml-4">
                                                    {% if "ROLE_ADMIN" in app.user.roles %}
                                                        {{ include('commentaires/_delete_form.html.twig') }}
                                                    {% elseif commentaire.refUser == app.user %}
                                                        {{ include('commentaires/_delete_form.html.twig') }}
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>

                                <!-- Formulaire réponse -->
                                <div v-show="replyFormsVisible['{{ idSujet }}']" class="mt-6 p-4 bg-gray-50 rounded-lg">
                                    <h5 class="font-medium text-gray-800 mb-3">Ajouter une réponse</h5>
                                    <form class="space-y-3" @submit.prevent="envoyerReponse('{{ sujet.id }}')">
                                    <textarea v-model="replyContents['{{ sujet.id }}']" rows="3"
                                              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
                                              placeholder="Écrivez votre réponse..."></textarea>
                                        <div class="flex items-center space-x-3">
                                            <button type="button" @click="cancelReplyForm('{{ idSujet }}')" class="btn btn-outline btn-small">
                                                Annuler
                                            </button>
                                            <button type="submit" class="btn btn-primary btn-small">
                                                Répondre
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </main>
        </div>
        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(pagination) }}
        </div>
        <!-- Footer -->
        <footer class="bg-blue-900 text-white py-8 mt-auto text-center">
            <!-- Footer content -->
        </footer>
    </div>

    <!-- Vue.js -->
    <script src="https://cdn.jsdelivr.net/npm/vue@2"></script>
    <script>
        new Vue({
            el: '#app',
            delimiters: ['[[', ']]'],
            data() {
                return {
                    showNewTopicForm: false,
                    newTopic: {
                        titre: '',
                        message: ''
                    },
                    repliesVisible: {},
                    replyFormsVisible: {},
                    replyContents: {},
                    fluxId: window.location.pathname.split('/')[2]
                };
            },
            methods: {
                toggleNewTopicForm() {
                    this.showNewTopicForm = !this.showNewTopicForm;
                },
                publierSujet() {
                    const { titre, message } = this.newTopic;
                    if (!titre || !message) {
                        alert('Merci de remplir tous les champs.');
                        return;
                    }

                    const formData = new FormData();
                    formData.append('titre', titre);
                    formData.append('message', message);
                    formData.append('refFluxId', this.fluxId);

                    fetch('/flux/new', {
                        method: 'POST',
                        body: formData
                    }).then(() => window.location.reload());
                },
                annulerSujet() {
                    this.newTopic = { titre: '', message: '' };
                    this.showNewTopicForm = false;
                },
                toggleReplies(id) {
                    this.$set(this.repliesVisible, id, !this.repliesVisible[id]);
                },
                toggleReplyForm(id) {
                    this.$set(this.replyFormsVisible, id, !this.replyFormsVisible[id]);
                },
                cancelReplyForm(id) {
                    this.$set(this.replyFormsVisible, id, false);
                    this.replyContents[id] = '';
                },
                envoyerReponse(sujetId) {
                    const reponse = this.replyContents[sujetId]?.trim();
                    if (!reponse) {
                        alert('Merci de remplir votre réponse.');
                        return;
                    }

                    const formData = new FormData();
                    formData.append('reponse', reponse);
                    formData.append('refSujetId', sujetId);
                    formData.append('refFluxId', this.fluxId);

                    fetch('/flux/new', {
                        method: 'POST',
                        body: formData
                    }).then(() => window.location.reload());
                }
            }
        });
    </script>
{% endblock %}
