{% extends 'base.html.twig' %}

{% block title %}
    Se connecter
{% endblock %}

{% block body %}

    {{ parent() }}

    <div class="container mt-5">
        <div class="card shadow p-4">
            <h2 class="mb-4">Se connecter</h2>

            {% if error %}
                <div class="alert alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="alert alert-info">
                    Bonjour, {{ app.user.userIdentifier }},
                    vous êtes connecté.
                    <a href="{{ path('app_logout') }}" class="btn btn-link p-0">Se déconnecter</a>
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-3">
                    <label for="inputEmail" class="form-label">Email</label>
                    <input type="email"
                           value="{{ last_username }}"
                           name="email"
                           id="inputEmail"
                           class="form-control"
                           autocomplete="email"
                           required
                           autofocus>
                </div>

                <div class="mb-3">
                    <label for="inputPassword" class="form-label">Mot de passe</label>
                    <input type="password"
                           name="password"
                           id="inputPassword"
                           class="form-control"
                           autocomplete="current-password"
                           required>
                </div>

                <input type="hidden"
                       name="_csrf_token"
                       value="{{ csrf_token('authenticate') }}">

                <div class="form-check mb-3">
                    <input class="form-check-input"
                           type="checkbox"
                           name="_remember_me"
                           id="remember_me">
                    <label class="form-check-label" for="remember_me">
                        Se souvenir de moi ?
                    </label>
                </div>

                <button class="btn btn-primary" type="submit">
                    Se connecter
                </button>

            </form>
            <br>
            <a href="{{ path('app_demande_reset_password') }}">
                <button class="btn btn-primary">Mot de passe oublié</button>
            </a>
        </div>
    </div>

{% endblock %}
