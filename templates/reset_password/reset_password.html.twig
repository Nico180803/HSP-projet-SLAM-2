{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
    {{ parent() }}
    <div class="container py-5 d-flex flex-column align-items-center justify-content-center min-vh-100">
        <div class="w-100" style="max-width:480px;">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    {# HEADER #}
                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center"
                             style="width:56px;height:56px;">
                            <i class="bi bi-shield-lock-fill fs-4"></i>
                        </div>
                        <h1 class="h4 fw-bold mt-3 mb-1">Définir un nouveau mot de passe</h1>
                        <p class="text-muted small mb-0">Saisis ton nouveau mot de passe, puis confirme-le.</p>
                    </div>

                    {# FLASHES #}
                    {% for m in app.flashes('error') %}
                        <div class="alert alert-danger small">{{ m }}</div>
                    {% endfor %}

                    {# FORMULAIRE: mdp + mdpConfirm #}
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.mdp, 'Mot de passe', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <div class="input-group">
                                {{ form_widget(form.mdp, {'attr': {'class': 'form-control', 'placeholder' : '••••••••'}}) }}
                                {{ form_errors(form.mdp) }}
                            </div>
                            <div class="form-text">Au moins 6 caractères.</div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.mdpConfirm, 'Confirmer le mot de passe', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <div class="input-group">
                                {{ form_widget(form.mdpConfirm, {'attr': {'class': 'form-control', 'placeholder' : '••••••••'}}) }}
                                {{ form_errors(form.mdpConfirm) }}
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-check2-circle me-1"></i> Enregistrer le nouveau mot de passe
                        </button>
                    {{ form_end(form) }}

                    {# AIDE #}
                    <div class="text-muted small mt-3">
                        Le mot de passe et sa confirmation doivent être identiques.
                    </div>

                </div>
            </div>

        </div>
    </div>
{% endblock %}
