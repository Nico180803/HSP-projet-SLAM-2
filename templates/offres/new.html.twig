{% extends 'base.html.twig' %}

{% block title %}Nouvelle offre{% endblock %}

{% block body %}
    {{ parent() }}

    <section class="section py-5">
        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="section-title m-0">
                    <h2 class="mb-1">Créer une nouvelle offre</h2>
                    <p class="text-muted mb-0">Renseignez les informations de l’offre</p>
                </div>

                {% if 'ROLE ADMIN' in app.user.roles %}
                    <a href="{{ path('app_offres_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                    </a>
                {% else %}
                    <a href="{{ path('app_offres_view') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                    </a>
                {% endif %}
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card shadow-sm border-0" data-aos="fade-up" data-aos-delay="150">
                        <div class="card-body p-4">
                            {{ include('offres/_form.html.twig', { button_label: 'Créer l\'offre' }) }}
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card shadow-sm border-0" data-aos="fade-up" data-aos-delay="200">
                        <div class="card-body">
                            <h5 class="fw-semibold mb-2">
                                <i class="bi bi-info-circle me-2"></i>Astuce
                            </h5>
                            <p class="text-muted mb-0">
                                Soignez le titre et la description de l’offre pour la rendre plus attractive.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
{% endblock %}
