{% extends 'base.html.twig' %}

{% block body %}
    {{ parent() }}

    <section id="users" class="section bg-light py-5">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
            <div class="section-header text-center mb-5">
                <h2 class="section-title" data-aos="fade-up" data-aos-delay="200">Liste des offres</h2>
            </div>

            <div class="text-center mt-4">
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    {% if 'ROLE_ENTREPRISE' in app.user.roles %}
                        <a href="{{ path('app_offres_new') }}" class="btn btn-primary" data-aos="fade-up" data-aos-delay="150">
                            <i class="bi bi-person-plus-fill me-2"></i>Créer une nouvelle offre
                        </a>
                    {% endif %}
                {% endif %}
            </div>

            <hr data-aos="fade-up" data-aos-delay="150">

            <div class="row">
                <form method="get" action="{{ path('app_offres_view') }}" class="mb-4 d-flex" role="search">
                    <input
                        type="text"
                        name="search"
                        class="form-control me-2"
                        placeholder="Rechercher une offre (titre, description)..."
                        value="{{ search is defined ? search : app.request.get('search') }}"
                    >
                    <button type="submit" class="btn btn-primary">Rechercher</button>
                </form>

                {% for offre in pagination %}

                    <div class="col-md-3 col-lg-4 mb-2" data-aos="fade-up" data-aos-delay="{{ 200 + loop.index * 50 }}">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="bi bi-person-circle me-2"></i>{{ offre.titre }}
                                    <span class="badge bg-primary-subtle text-dark">
                                        {% if offre.refUser %}
                                            Nombre de candidature: {{ offre.refUser|length }}
                                        {% else %}
                                            Nombre de candidature: 0
                                        {% endif %}
                                    </span>
                                </h5>

                                <p class="card-text mb-2">
                                    <strong>Salaire:</strong>
                                    <span class="badge bg-primary-subtle text-dark">
                                        {{ offre.salaire }} euros
                                    </span>
                                    <br>
                                    <strong>Date de création:</strong> {{ offre.dateCreation|date('d/m/Y') }} <br>
                                    <strong>Date de fermeture:</strong> {{ offre.dateFermeture|date('d/m/Y') }}<br>
                                    {% set firstContact = offre.contactsEntreprises|first %}
                                    <strong>Contact :</strong>
                                    {% if firstContact %}
                                        {{ firstContact.prenom }} {{ firstContact.nom }}
                                        {% if firstContact.fonction %} – {{ firstContact.fonction }}{% endif %}<br>
                                        {% if firstContact.tel %}📞 {{ firstContact.tel }}<br>{% endif %}
                                        {% if firstContact.mail %}📧 {{ firstContact.mail }}{% endif %}
                                    {% else %}
                                        <span class="text-muted">Aucun contact renseigné</span>
                                    {% endif %}
                                </p>

                                <p class="small text-muted">
                                    <strong>Description:</strong> {{ offre.description }}
                                </p>

                                <div class="d-flex justify-content-between">
                                    <a href="{{ path('app_offres_showOffre', {'id': offre.id}) }}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>

                                    {% if 'ROLE_ENTREPRISE' in app.user.roles %}

                                        <a href="{{ path('app_offres_edit', {'id': offre.id}) }}" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil"></i> Modifier
                                        </a>
                                    {% endif %}
                                    {% if 'ROLE_ETUDIANT' in app.user.roles %}
                                            {% if app.user in offre.refUser %}

                                        <a href="{{ path('app_offres_postuler', {'id': offre.id}) }}" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil"></i> Postuler
                                        </a>
                                            {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center">
                        <div class="alert alert-warning" role="alert" data-aos="fade-up">
                            Aucune offre trouvée.
                        </div>
                    </div>
                {% endfor %}

                <div class="d-flex justify-content-center mt-4">
                    {{ knp_pagination_render(pagination) }}
                </div>
            </div>

        </div>
    </section>
{% endblock %}
