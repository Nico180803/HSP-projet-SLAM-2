{% extends 'base.html.twig' %}


{% block body %}
    {{ parent() }}


    <section id="user-profile" class="section py-5 bg-light">
        <div class="container" data-aos="fade-up">
            <div class="row justify-content-center">
                <div class="col-lg-8">

                    <div class="card shadow-lg">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-4">
                                <div class="me-3">
                                    <i class="bi bi-person-circle" style="font-size: 3rem;"></i>
                                </div>
                                <div>
                                    <h4 class="card-title mb-0">{{ offre.titre }}</h4>

                                </div>
                            </div>


                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <p><strong>Salaire:</strong> {{ offre.salaire }}</p>
                                        <p><strong>Date de création:</strong> {{ offre.dateCreation|date('d/m/Y') }}</p>
                                        <p><strong>Date de fermeture:</strong> {{ offre.dateFermeture|date('d/m/Y') }}</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Contact: </strong>test</p>

                                    </div>
                                </div>













                            <div class="d-flex justify-content-between mt-4">

                                    <a href="{{ path('app_offres_view') }}" class="btn btn-outline-secondary">
                                        <i class="bi bi-arrow-left"></i> Retour à la liste
                                    </a>

                                {% if 'ROLE_ENTREPRISE' in app.user.roles %} {# ajouter une condition seulement l'entreprise qui a creer peut modifier #}
                                <div class="d-flex gap-2">
                                    <a href="{{ path('app_offres_edit', {'id': offre.id}) }}" class="btn btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>
                                </div>
                                {% endif %}
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>

{% endblock %}
