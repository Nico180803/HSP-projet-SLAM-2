{% extends 'base.html.twig' %}

{% block title %}Offres{% endblock %}

{% block body %}
    {{ parent() }}
    <h1>Offres</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ offre.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ offre.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ offre.description }}</td>
            </tr>
            <tr>
                <th>Salaire</th>
                <td>{{ offre.salaire }}</td>
            </tr>
            <tr>
                <th>Date_creation</th>
                <td>{{ offre.dateCreation ? offre.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Date_fermeture</th>
                <td>{{ offre.dateFermeture ? offre.dateFermeture|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Pj</th>
                <td>{{ offre.pj }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_offres_index') }}">back to list</a>

    <a href="{{ path('app_offres_edit', {'id': offre.id}) }}">edit</a>

    {{ include('offres/_delete_form.html.twig') }}
{% endblock %}
