{% extends 'base.html.twig' %}


{% block body %}
    {{ parent() }}


    <section id="user-profile" class="section py-5 bg-light">
        <div class="container" data-aos="fade-up">
            <div class="row justify-content-center">
                <div class="col-lg-8">

                    <div class="card shadow-lg">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-4">
                                <div class="me-3">
                                    <i class="bi bi-person-circle" style="font-size: 3rem;"></i>
                                </div>
                                <div>
                                    <h4 class="card-title mb-0">{{ user.prenom }} {{ user.nom }}</h4>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <small class="text-muted">Utilisateur #{{ user.id }}</small>
                                    {% endif %}
                                </div>
                            </div>

                            {# Affiche tout si admin #}
                            {% if is_granted('ROLE_ADMIN') %}
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <p><strong>Email:</strong> {{ user.email }}</p>
                                        <p><strong>Rôles:</strong> {{ user.roles ? user.roles|join(', ') : 'N/A' }}</p>
                                        <p><strong>Spécialité:</strong> {{ user.specialite }}</p>
                                        <p><strong>Formation:</strong> {{ user.formation }}</p>
                                        <p><strong>Validé:</strong>
                                            {% if user.EstValide %}
                                                <span class="badge bg-success">Oui</span>
                                            {% else %}
                                                <span class="badge bg-danger">Non</span>
                                            {% endif %}
                                        </p>
                                        <p><strong>Date de création:</strong> {{ user.dateCreation ? user.dateCreation|date('Y-m-d H:i') : 'N/A' }}</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>CV:</strong> {{ user.cv }}</p>
                                        <p><strong>Rue Entreprise:</strong> {{ user.rueEntreprise }} {{ user.nbRueEntreprise }}</p>
                                        <p><strong>Code Postal:</strong> {{ user.cpEntreprise }}</p>
                                        <p><strong>Ville:</strong> {{ user.villeEntreprise }}</p>
                                        <p><strong>Pays:</strong> {{ user.pays }}</p>
                                    </div>
                                </div>

                                {# Sinon selon les rôles #}
                            {% else %}
                                {% set roles = user.roles|default([]) %}
                                {# Champs communs #}
                                <hr>
                                <p><strong>Email:</strong> {{ user.email }}</p>
                                <p><strong>Validé:</strong>
                                    {% if user.EstValide %}
                                        <span class="badge bg-success">Oui</span>
                                    {% else %}
                                        <span class="badge bg-danger">Non</span>
                                    {% endif %}
                                </p>
                                <hr>

                                {% if 'ROLE_ETUDIANT' in roles %}
                                    <h5>Informations Étudiant</h5>
                                    <p><strong>CV:</strong>
                                    {% if app.user.cv %}
                                    <a href="{{ asset('uploads/cv/' ~ app.user.cv) }}" target="_blank" download>
                                        Télécharger le CV
                                    </a>
                                {% else %}
                                    <p>Pas de CV disponible.</p>
                                {% endif %}</p>
                                    <p><strong>Formation:</strong> {{ user.formation }}</p>
                                {% endif %}

                                {% if 'ROLE_MEDECIN' in roles %}
                                    <h5>Informations Medecin</h5>
                                    <p><strong>Spécialité:</strong> {{ user.specialite }}</p>
                                {% endif %}

                                {% if 'ROLE_ENTREPRISE' in roles %}
                                    <h5>Informations Entreprise</h5>
                                    <p><strong>Adresse:</strong> {{ user.nbRueEntreprise }} {{ user.rueEntreprise }}</p>
                                    <p><strong>Code Postal:</strong> {{ user.cpEntreprise }}</p>
                                    <p><strong>Ville:</strong> {{ user.villeEntreprise }}</p>
                                    <p><strong>Pays:</strong> {{ user.pays }}</p>
                                {% endif %}


                            {% endif %}

                            <div class="d-flex justify-content-between mt-4">
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">
                                        <i class="bi bi-arrow-left"></i> Retour à la liste
                                    </a>
                                {% endif %}

                                <div class="d-flex gap-2">
                                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>

                                    <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce compte ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                        <button class="btn btn-danger">
                                            <i class="bi bi-trash"></i> Supprimer le compte
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>

{% endblock %}
