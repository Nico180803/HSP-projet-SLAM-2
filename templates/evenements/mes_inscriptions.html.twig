{% extends 'base.html.twig' %}

{% block title %}Mes inscriptions aux évènements{% endblock %}

{% block body %}
    {{ parent() }}

    <section class="section py-5">
        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Titre -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="section-title m-0">
                    <h2 class="mb-1">Mes inscriptions</h2>
                    <p class="text-muted mb-0">Évènements auxquels vous êtes inscrit</p>
                </div>

                <a href="{{ path('app_evenements_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Créer un événement
                </a>
            </div>

            {% if evenements is empty %}

                <div class="card shadow-sm border-0" data-aos="fade-up" data-aos-delay="150">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-calendar-check display-5 d-block mb-3"></i>
                        <h5 class="fw-semibold mb-2">Aucune inscription</h5>
                        <p class="text-muted mb-0">
                            Vous ne vous êtes inscrit à aucun événement pour le moment.
                        </p>
                    </div>
                </div>

            {% else %}

                <div class="d-flex flex-column gap-4">

                    {% for evenement in evenements %}
                        <div class="card shadow-sm border-0" data-aos="fade-up" data-aos-delay="{{ loop.index * 80 }}">
                            <div class="card-body p-4 d-flex justify-content-between align-items-start">

                                <!-- Infos événement -->
                                <div class="me-4">
                                    <h5 class="fw-bold text-primary mb-1">
                                        <i class="bi bi-calendar-event me-1"></i> {{ evenement.titre }}
                                    </h5>

                                    <p class="text-muted mb-2">
                                        <i class="bi bi-geo-alt me-1"></i>
                                        {{ evenement.ville }},
                                        {{ evenement.rue ?? 'Adresse non précisée' }},
                                        {{ evenement.cp ?? '' }}
                                    </p>

                                    <p class="mb-2">
                                        {{ evenement.description|length > 100
                                        ? evenement.description|slice(0, 100) ~ '…'
                                        : evenement.description
                                        }}
                                    </p>

                                    <div class="d-flex align-items-center gap-3 mt-3">
                                        <span class="badge bg-info text-dark">
                                            <i class="bi bi-people me-1"></i>
                                            {{ evenement.nbPlacesDispo }} places dispo
                                        </span>

                                        {% if evenement.estValide %}
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i> Validé
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-hourglass-split me-1"></i> En attente
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="text-end d-flex flex-column gap-2">

                                    <!-- Voir -->
                                    <a href="{{ path('app_evenements_show', {'id': evenement.id}) }}"
                                       class="btn btn-sm btn-outline-secondary w-100">
                                        <i class="bi bi-eye me-1"></i> Voir
                                    </a>

                                    <!-- Modifier si admin -->
                                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MEDECIN') %}
                                        <a href="{{ path('app_evenements_edit', {'id': evenement.id}) }}"
                                           class="btn btn-sm btn-outline-primary w-100">
                                            <i class="bi bi-pencil-square me-1"></i> Modifier
                                        </a>

                                        <form method="post"
                                              action="{{ path('app_evenements_delete', {'id': evenement.id}) }}"
                                              onsubmit="return confirm('Supprimer cet événement ?');">
                                            <input type="hidden"
                                                   name="_token"
                                                   value="{{ csrf_token('delete' ~ evenement.id) }}">
                                            <button class="btn btn-sm btn-outline-danger w-100">
                                                <i class="bi bi-trash me-1"></i> Supprimer
                                            </button>
                                        </form>
                                    {% endif %}

                                </div>

                            </div>
                        </div>
                    {% endfor %}

                </div>

            {% endif %}
        </div>
    </section>
{% endblock %}
