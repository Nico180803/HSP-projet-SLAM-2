{% extends 'base.html.twig' %}

{% block title %}Mes Évènements{% endblock %}

{% block body %}
    {{ parent() }}

    <div class="container py-5">

        <div class="bg-white shadow-sm rounded p-4 mb-4 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-primary mb-0">Mes événements</h2>
                <p class="text-muted mb-0">Liste des événements dont vous êtes responsable</p>
            </div>

            <a href="{{ path('app_evenements_new') }}" class="btn btn-primary">
                Créer un événement
            </a>
        </div>

        {% if evenements is empty %}
            <div class="alert alert-info text-center shadow-sm rounded">
                Vous n’êtes responsable d’aucun événement pour le moment.
            </div>
        {% else %}
            <div class="d-flex flex-column gap-4">
                {% for evenement in evenements %}
                    <div class="card shadow-sm border-0">
                        <div class="card-body d-flex justify-content-between">

                            <div>
                                <h5 class="fw-bold text-primary mb-1">{{ evenement.titre }}</h5>

                                <p class="text-muted mb-2">
                                    {{ evenement.ville }},
                                    {{ evenement.rue ?? 'Adresse non précisée' }},
                                    {{ evenement.cp ?? '' }}
                                </p>

                                <p class="mb-2">
                                    {{ evenement.description|length > 100
                                    ? evenement.description|slice(0, 100) ~ '...'
                                    : evenement.description
                                    }}
                                </p>

                                <div class="d-flex align-items-center gap-3 mt-2">
                                    <span class="badge bg-info text-dark">
                                        {{ evenement.nbPlacesDispo }} places dispo
                                    </span>

                                    {% if evenement.estValide %}
                                        <span class="badge bg-success">Validé</span>
                                    {% else %}
                                        <span class="badge bg-secondary">En attente</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="text-end d-flex flex-column gap-2">
                                <a href="{{ path('app_evenements_show', {'id': evenement.id}) }}"
                                   class="btn btn-outline-primary btn-sm w-100">
                                    Voir
                                </a>

                                <a href="{{ path('app_evenements_edit', {'id': evenement.id}) }}"
                                   class="btn btn-outline-warning btn-sm w-100 text-dark">
                                    Modifier
                                </a>

                                <form method="post"
                                      action="{{ path('app_evenements_delete', {'id': evenement.id}) }}"
                                      onsubmit="return confirm('Supprimer cet événement ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                                    <button class="btn btn-outline-danger btn-sm w-100">Supprimer</button>
                                </form>
                            </div>

                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
{% endblock %}
