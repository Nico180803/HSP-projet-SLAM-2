{% extends 'base.html.twig' %}

{% block title %}Edit Evenements{% endblock %}

{% block body %}
    <h1>Edit Evenements</h1>

    {% for message in app.flashes('success') %}
        <p>{{ message }}</p>
    {% endfor %}
    {{ include('evenements/_form.html.twig', {'button_label': 'Update'}) }}

    {{ form_start(form) }}
    {{ form_row(form.title) }}
    {{ form_row(form.description) }}
    {{ form_row(form.date) }}
    {{ form_row(form.location) }}

    <a href="{{ path('app_evenements_index') }}">back to list</a>


    <button type="submit">Enregistrer</button>
    {{ form_end(form) }}
{% endblock %}

