{% extends 'base.html.twig' %}

{% block title %}Tous les évènements{% endblock %}

{% block body %}
    {{ parent() }}

    <section class="section py-5">
        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <!-- Titre + actions -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="section-title m-0">
                    <h2 class="mb-1">Tous les évènements</h2>
                    <p class="text-muted mb-0">Découvrez et gérez les activités de la communauté</p>
                </div>

                <a href="{{ path('app_evenements_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Nouvel événement
                </a>
            </div>

            {% if evenements is empty %}
                <div class="card shadow-sm border-0" data-aos="fade-up" data-aos-delay="150">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-calendar-x display-5 d-block mb-3"></i>
                        <h5 class="fw-semibold mb-2">Aucun événement disponible</h5>
                        <p class="text-muted mb-0">
                            Créez votre premier événement pour qu’il apparaisse ici.
                        </p>

                        <a href="{{ path('app_evenements_new') }}" class="btn btn-primary mt-3">
                            <i class="bi bi-plus-circle me-1"></i> Créer un événement
                        </a>
                    </div>
                </div>

            {% else %}

                <div class="d-flex flex-column gap-4">

                    {% for evenement in evenements %}
                        <div class="card shadow-sm border-0" data-aos="fade-up" data-aos-delay="{{ loop.index * 80 }}">
                            <div class="card-body p-4 d-flex justify-content-between align-items-start">

                                <div class="me-4">
                                    <h5 class="fw-bold text-primary mb-1">
                                        <i class="bi bi-calendar-event me-1"></i> {{ evenement.titre }}
                                    </h5>

                                    <p class="text-muted mb-2">
                                        <i class="bi bi-geo-alt me-1"></i>
                                        {{ evenement.ville }} —
                                        {{ evenement.rue ?? 'Adresse non précisée' }},
                                        {{ evenement.cp ?? '' }}
                                    </p>

                                    <p class="mb-2">
                                        {{ evenement.description|length > 100
                                        ? evenement.description|slice(0, 100) ~ '…'
                                        : evenement.description }}
                                    </p>

                                    <div class="d-flex align-items-center gap-3 mt-3">
                                        <span class="badge bg-info text-dark">
                                            {{ evenement.nbPlacesDispo > 0
                                            ? evenement.nbPlacesDispo ~ ' places dispo'
                                            : 'Complet' }}
                                        </span>

                                        {% if evenement.estValide %}
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i> Validé
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-hourglass-split me-1"></i> Non validé
                                            </span>
                                        {% endif %}
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="text-end d-flex flex-column gap-2">

                                    <a href="{{ path('app_evenements_show', {'id': evenement.id}) }}"
                                       class="btn btn-sm btn-outline-secondary w-100">
                                        <i class="bi bi-eye me-1"></i> Voir
                                    </a>

                                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MEDECIN') %}
                                        <a href="{{ path('app_evenements_edit', {'id': evenement.id}) }}"
                                           class="btn btn-sm btn-outline-primary w-100">
                                            <i class="bi bi-pencil-square me-1"></i> Modifier
                                        </a>
                                    {% endif %}

                                    {% if evenement.nbPlacesDispo > 0 %}
                                        {% if app.user %}
                                            {% set alreadyRegistered = false %}
                                            {% for ue in evenement.userEvenements %}
                                                {% if ue.refUser == app.user %}
                                                    {% set alreadyRegistered = true %}
                                                {% endif %}
                                            {% endfor %}

                                            {% if not alreadyRegistered %}
                                                <a href="{{ path('app_evenement_join', {'id': evenement.id}) }}"
                                                   class="btn btn-primary btn-sm w-100">
                                                    <i class="bi bi-check2-circle me-1"></i> S'inscrire
                                                </a>
                                            {% else %}
                                                <button class="btn btn-secondary btn-sm w-100" disabled>
                                                    <i class="bi bi-person-check me-1"></i> Déjà inscrit
                                                </button>
                                            {% endif %}
                                        {% else %}
                                            <a href="{{ path('app_login') }}" class="btn btn-primary btn-sm w-100">
                                                <i class="bi bi-box-arrow-in-right me-1"></i> Connectez-vous
                                            </a>
                                        {% endif %}
                                    {% else %}
                                        <button class="btn btn-danger btn-sm w-100 mb-1" disabled>
                                            <i class="bi bi-x-circle me-1"></i> Complet
                                        </button>
                                        {% if app.user %}
                                            {% set enAttente = false %}
                                            {% for ue in evenement.userEvenements %}
                                                {% if ue.refUser == app.user and ue.statut %}
                                                    {% set enAttente = true %}
                                                {% endif %}
                                            {% endfor %}

                                            {% if enAttente %}
                                                <button class="btn btn-warning btn-sm w-100" disabled>
                                                    <i class="bi bi-hourglass-split me-1"></i> En liste d'attente
                                                </button>
                                            {% else %}
                                                <a href="{{ path('app_evenement_waitlist', {'id': evenement.id}) }}"
                                                   class="btn btn-warning btn-sm w-100">
                                                    <i class="bi bi-clock me-1"></i> Liste d'attente
                                                </a>
                                            {% endif %}
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                </div>

            {% endif %}
        </div>
    </section>
{% endblock %}
