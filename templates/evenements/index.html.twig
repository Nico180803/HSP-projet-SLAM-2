{% extends 'base.html.twig' %}

{% block title %}Liste des Événements{% endblock %}

{% block body %}
    {{ parent() }}
    <div class="container py-5">
        <div class="bg-white shadow-sm rounded p-4 mb-4 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-primary mb-0">Événements à venir</h2>
                <p class="text-muted mb-0">Découvrez les activités de la communauté</p>
            </div>
            <a href="{{ path('app_evenements_new') }}" class="btn btn-primary">Nouvel Événement</a>
        </div>

        {% if evenements is empty %}
            <div class="alert alert-warning text-center shadow-sm rounded">
                Aucun événement n’est disponible pour le moment.
            </div>
        {% else %}
            <div class="d-flex flex-column gap-4">
                {% for evenement in evenements %}
                    <div class="card shadow-sm border-0">
                        <div class="card-body d-flex justify-content-between">
                            <div>
                                <h5 class="fw-bold text-primary mb-1">{{ evenement.titre }}</h5>
                                <p class="text-muted mb-2">
                                    {{ evenement.ville }} — {{ evenement.rue ?? 'Adresse non précisée' }}, {{ evenement.cp ?? '' }}
                                </p>
                                <p class="mb-2">{{ evenement.description|length > 100 ? evenement.description|slice(0, 100) ~ '...' : evenement.description }}</p>

                                <div class="d-flex align-items-center gap-3 mt-2">
                                <span class="badge bg-info text-dark">
                                    {{ evenement.nbPlacesDispo > 0 ? evenement.nbPlacesDispo ~ ' places dispo' : 'Complet' }}
                                </span>
                                    {% if evenement.estValide %}
                                        <span class="badge bg-success">Validé</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Non validé</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="text-end d-flex flex-column gap-2">
                                <a href="{{ path('app_evenements_show', {'id': evenement.id}) }}" class="btn btn-outline-primary btn-sm w-100">Voir détails</a>
                                <a href="{{ path('app_evenements_edit', {'id': evenement.id}) }}" class="btn btn-outline-warning btn-sm w-100 text-dark">Modifier</a>

                                {% if evenement.nbPlacesDispo > 0 %}
                                    {% if app.user %}
                                        {% set alreadyRegistered = false %}
                                        {% for ue in evenement.userEvenements %}
                                            {% if ue.refUser == app.user %}
                                                {% set alreadyRegistered = true %}
                                            {% endif %}
                                        {% endfor %}

                                        {% if not alreadyRegistered %}
                                            <a href="{{ path('app_evenement_join', {'id': evenement.id}) }}" class="btn btn-primary btn-sm w-100">S'inscrire</a>
                                        {% else %}
                                            <button class="btn btn-secondary btn-sm w-100" disabled>Déjà inscrit</button>
                                        {% endif %}
                                    {% else %}
                                        <a href="{{ path('app_login') }}" class="btn btn-primary btn-sm w-100">Connectez-vous pour vous inscrire</a>
                                    {% endif %}
                                {% else %}
                                    <button class="btn btn-danger btn-sm w-100" disabled>Complet</button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
