{% extends 'base.html.twig' %}

{% block title %}Création d'un évènement{% endblock %}

{% block body %}
    <div class="container mt-5" style="max-width: 650px;">
        <h1 class="mb-4" style="font-size: 1.8rem; font-weight: 500;">{{ title }}</h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        <div class="form-block p-4 border rounded" style="background-color: #f9f9f9; box-shadow: 0 2px 6px rgba(0,0,0,0.05);">
            {{ form_start(form) }}

            {{ form_widget(form) }}

            <button class="btn btn-primary mt-3">{{ button_label }}</button>

            {{ form_end(form) }}
        </div>

        <div class="mt-3">
            <a href="{{ path('app_evenements_index') }}" class="btn btn-secondary">Revenir à la liste des événements</a>
        </div>
    </div>

    <style>
        .form-block input[type="text"],
        .form-block input[type="date"],
        .form-block input[type="time"],
        .form-block textarea,
        .form-block select {
            width: 100%;
            padding: 0.5rem 0.7rem;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 0.95rem;
            box-sizing: border-box;
            transition: border-color 0.2s ease-in-out;
        }

        .form-block input:focus,
        .form-block textarea:focus,
        .form-block select:focus {
            border-color: #007bff;
            outline: none;
        }

        .form-block label {
            display: block;
            margin-bottom: 0.3rem;
            font-weight: 500;
            font-size: 0.95rem;
        }

        .form-block textarea {
            min-height: 80px;
            resize: vertical;
        }

        h1 {
            color: #333;
        }

        .btn {
            padding: 0.45rem 0.85rem;
            font-size: 0.95rem;
            border-radius: 5px;
        }

        .alert-success {
            padding: 0.6rem 0.9rem;
            margin-bottom: 1rem;
            border: 1px solid #c3e6cb;
            background-color: #d4edda;
            color: #155724;
            border-radius: 5px;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const select = document.querySelector('select[name$="[responsables][]"]');
            if (!select) return;

            // ------- Barre de recherche -------
            const input = document.createElement('input');
            input.type = 'text';
            input.placeholder = 'Tapez pour chercher un responsable...';
            input.style.margin = '0 0 10px 0';
            select.parentNode.insertBefore(input, select);

            input.addEventListener('input', () => {
                const filter = input.value.toLowerCase();
                Array.from(select.options).forEach(option => {
                    option.style.display = option.text.toLowerCase().includes(filter) ? 'block' : 'none';
                });
            });

            // ------- Bouton AUCUN RESPONSABLE -------
            const noneBtn = document.createElement('button');
            noneBtn.type = "button";
            noneBtn.textContent = "Aucun responsable";
            noneBtn.className = "btn btn-secondary mt-2";
            noneBtn.style.width = "100%";

            select.parentNode.appendChild(noneBtn);

            noneBtn.addEventListener('click', () => {
                Array.from(select.options).forEach(opt => opt.selected = false);
            });
        });
    </script>
{% endblock %}
