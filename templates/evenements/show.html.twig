{% extends 'base.html.twig' %}

{% block title %}Détail de l'évènement{% endblock %}

{% block body %}
    {{ parent() }}

    <section id="event-detail" class="section py-5 bg-light">
        <div class="container" data-aos="fade-up">
            <div class="row justify-content-center">
                <div class="col-lg-8">

                    <div class="card shadow-lg">
                        <div class="card-body">

                            {# HEADER #}
                            <div class="d-flex align-items-center mb-4">
                                <div class="me-3">
                                    <i class="bi bi-calendar-event" style="font-size: 3rem;"></i>
                                </div>
                                <div>
                                    <h4 class="card-title mb-0">{{ evenement.titre }}</h4>
                                    <small class="text-muted">Événement #{{ evenement.id }}</small>
                                </div>
                            </div>

                            <hr>

                            {# INFOS #}
                            <p><strong>Description :</strong> {{ evenement.description ?: 'Aucune description' }}</p>

                            <p><strong>Adresse :</strong>
                                {{ evenement.nbRue }} {{ evenement.rue }},
                                {{ evenement.cp }} {{ evenement.ville }}
                            </p>

                            <p><strong>Date de début :</strong> {{ evenement.dateDebut|date('d/m/Y H:i') }}</p>
                            <p><strong>Date de fin :</strong> {{ evenement.dateFin|date('d/m/Y H:i') }}</p>

                            <p><strong>Places restantes :</strong>
                                {% if evenement.nbPlacesDispo > 0 %}
                                    <span class="badge bg-success">{{ evenement.nbPlacesDispo }}</span>
                                {% else %}
                                    <span class="badge bg-danger">Complet</span>
                                {% endif %}
                            </p>

                            <p><strong>Validé :</strong>
                                {% if evenement.estValide %}
                                    <span class="badge bg-success">Oui</span>
                                {% else %}
                                    <span class="badge bg-danger">Non</span>
                                {% endif %}
                            </p>

                            <hr>

                            {# ---------------- RESPONSABLES (ton ancien code exact) ---------------- #}
                            <h5 class="mb-3">Responsables</h5>

                            <div class="bg-light p-3 rounded border">
                                {% set responsables = evenement.userEvenements
                                    |filter(ue => ue.isResponsable)
                                    |slice(0, 9999)
                                %}

                                {% if responsables|length > 0 %}
                                    <ul class="list-group">
                                        {% for ue in responsables %}
                                            <li class="list-group-item">
                                                {{ ue.refUser.nom }} {{ ue.refUser.prenom }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p class="text-muted mb-0">Aucun responsable</p>
                                {% endif %}
                            </div>

                            <hr>

                            {# ---------------- INSCRITS (isResponsable = false) ---------------- #}
                            <h5 class="mb-3">Participants inscrits</h5>

                            {% set inscrits = evenement.userEvenements|filter(ue => not ue.isResponsable) %}

                            {% if inscrits is empty %}
                                <p class="text-muted">Aucun inscrit pour le moment.</p>
                            {% else %}
                                <ul class="list-group mb-3">
                                    {% for ue in inscrits %}
                                        <li class="list-group-item">
                                            {{ ue.refUser.prenom }} {{ ue.refUser.nom }}
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}

                            <hr>

                            {# ---------------- BOUTON MODIFIER ---------------- #}

                            {% set userIsResponsable = false %}
                            {% if app.user %}
                                {% for ue in evenement.userEvenements %}
                                    {% if ue.isResponsable and ue.refUser == app.user %}
                                        {% set userIsResponsable = true %}
                                    {% endif %}
                                {% endfor %}
                            {% endif %}

                            <div class="d-flex justify-content-between mt-4">

                                <a href="{{ path('app_evenements_index') }}" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left"></i> Retour à la liste
                                </a>

                                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MEDECIN') or userIsResponsable %}
                                    <a href="{{ path('app_evenements_edit', {'id': evenement.id}) }}" class="btn btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>
                                {% endif %}
                            </div>

                            <hr>

                            {# ---------------- INSCRIPTION / DESINSCRIPTION ---------------- #}

                            {% if app.user and evenement.estValide %}
                                {% set inscrit = false %}
                                {% set enAttente = false %}
                                {% for ue in evenement.userEvenements %}
                                    {% if ue.refUser == app.user %}
                                        {% if ue.statut %}
                                            {% set enAttente = true %}
                                        {% else %}
                                            {% set inscrit = true %}
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}

                                {% if inscrit %}
                                    <a href="{{ path('app_evenement_leave', {'id': evenement.id}) }}" class="btn btn-danger w-100">
                                        Se désinscrire
                                    </a>
                                {% elseif enAttente %}
                                    <button class="btn btn-warning w-100" disabled>
                                        <i class="bi bi-hourglass-split me-1"></i> Vous êtes en liste d'attente
                                    </button>
                                {% elseif evenement.nbPlacesDispo > 0 %}
                                    <a href="{{ path('app_evenement_join', {'id': evenement.id}) }}" class="btn btn-success w-100">
                                        S'inscrire
                                    </a>
                                {% else %}
                                    <button class="btn btn-secondary w-100 mb-2" disabled>Complet</button>
                                    <a href="{{ path('app_evenement_waitlist', {'id': evenement.id}) }}" class="btn btn-warning w-100">
                                        <i class="bi bi-clock me-1"></i> S'ajouter à la liste d'attente
                                    </a>
                                {% endif %}
                            {% endif %}

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>

{% endblock %}
