{% extends 'base.html.twig' %}

{% block title %}Événement{% endblock %}

{% block body %}
    <h1>Détails de l'événement</h1>

    <table class="table">
        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ evenement.id }}</td>
        </tr>
        <tr>
            <th>Titre</th>
            <td>{{ evenement.titre }}</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>{{ evenement.description }}</td>
        </tr>
        <tr>
            <th>Ville</th>
            <td>{{ evenement.ville }}</td>
        </tr>
        <tr>
            <th>Rue</th>
            <td>{{ evenement.rue }}</td>
        </tr>
        <tr>
            <th>Code Postal</th>
            <td>{{ evenement.cp }}</td>
        </tr>
        <tr>
            <th>Numéro rue</th>
            <td>{{ evenement.nbRue }}</td>
        </tr>
        <tr>
            <th>Nombre de places</th>
            <td>{{ evenement.nbPlaces }}</td>
        </tr>
        <tr>
            <th>Places disponibles</th>
            <td>{{ evenement.nbPlacesDispo }}</td>
        </tr>
        <tr>
            <th>Validé</th>
            <td>{{ evenement.estValide ? 'Oui' : 'Non' }}</td>
        </tr>
        <tr>
            <th>Responsables</th>
            <td>
                {% set responsables = evenement.userEvenements
                    |filter(ue => ue.isResponsable)
                    |slice(0, 9999) %}

                {% if responsables|length > 0 %}
                    {% for ue in responsables %}
                        {{ ue.refUser.nom }} {{ ue.refUser.prenom }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                {% else %}
                    Aucun responsable
                {% endif %}
            </td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('app_evenements_index') }}" class="btn btn-secondary">Retour à la liste</a>
    <a href="{{ path('app_evenements_edit', {'id': evenement.id}) }}" class="btn btn-primary">Modifier</a>

    {# Boutons inscription / désinscription #}
    {% if app.user and evenement.estValide %}
        {% set inscrit = evenement.userEvenements|filter(ue => ue.refUser.id == app.user.id)|length > 0 %}

        {% if inscrit %}
            <a href="{{ path('app_evenement_leave', {id: evenement.id}) }}" class="btn btn-danger">Se désinscrire</a>
        {% elseif evenement.nbPlacesDispo > 0 %}
            <a href="{{ path('app_evenement_join', {id: evenement.id}) }}" class="btn btn-success">S'inscrire</a>
        {% else %}
            <button class="btn btn-secondary" disabled>Complet</button>
        {% endif %}
    {% endif %}
{% endblock %}
