{% extends 'base.html.twig' %}

{% block title %}Evenements{% endblock %}

{% block body %}
    <h1>Evenements</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ evenement.id }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ evenement.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ evenement.description }}</td>
            </tr>
            <tr>
                <th>Ville</th>
                <td>{{ evenement.ville }}</td>
            </tr>
            <tr>
                <th>Rue</th>
                <td>{{ evenement.rue }}</td>
            </tr>
            <tr>
                <th>Cp</th>
                <td>{{ evenement.cp }}</td>
            </tr>
            <tr>
                <th>Nb_rue</th>
                <td>{{ evenement.nbRue }}</td>
            </tr>
            <tr>
                <th>Nb_places</th>
                <td>{{ evenement.nbPlaces }}</td>
            </tr>
            <tr>
                <th>Nb_places_dispo</th>
                <td>{{ evenement.nbPlacesDispo }}</td>
            </tr>
            <tr>
                <th>Est_valide</th>
                <td>{{ evenement.estValide ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_evenements_index') }}">back to list</a>

    <a href="{{ path('app_evenements_edit', {'id': evenement.id}) }}">edit</a>

    {{ include('evenements/_delete_form.html.twig') }}
{% endblock %}
