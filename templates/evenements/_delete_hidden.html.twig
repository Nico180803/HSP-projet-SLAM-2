<form method="post" id="delete_evenements_{{ evenement.id }}_form" action="{{ path('app_evenements_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Êtes vous sûr de votre suppression ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
</form>
