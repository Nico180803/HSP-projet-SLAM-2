<form method="post"
      action="{{ path('app_contacts_entreprise_delete', {'id': contacts_entreprise.id}) }}"
      onsubmit="return confirm('Supprimer ce contact ? Cette action est irréversible.');"
      class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contacts_entreprise.id) }}">
    <button class="btn btn-outline-danger{% if size is defined and size == 'sm' %} btn-sm{% endif %}">
        <i class="bi bi-trash3 me-1"></i> Supprimer
    </button>
</form>

