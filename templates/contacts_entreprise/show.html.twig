{% extends 'base.html.twig' %}

{% block title %}Contact – Entreprise{% endblock %}

{% block body %}
    {{ parent() }}

    <section class="section py-5">
        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="section-title m-0">
                    <h2 class="mb-1">Détails du contact</h2>
                    <p class="text-muted mb-0">Informations de l’interlocuteur</p>
                </div>
                <div class="d-inline-flex align-items-center gap-2">
                    <a href="{{ path('app_contacts_entreprise_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                    </a>
                    <a href="{{ path('app_contacts_entreprise_edit', {'id': contacts_entreprise.id}) }}" class="btn btn-primary">
                        <i class="bi bi-pencil-square me-1"></i> Modifier
                    </a>
                    {{ include('contacts_entreprise/_delete_form.html.twig', { contacts_entreprise: contacts_entreprise }) }}
                </div>
            </div>

            <div class="card shadow-sm border-0" data-aos="fade-up" data-aos-delay="150">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-lg-6">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item px-0 d-flex justify-content-between">
                                    <span class="text-muted">Fonction</span>
                                    <span class="fw-semibold">{{ contacts_entreprise.fonction }}</span>
                                </li>
                                <li class="list-group-item px-0 d-flex justify-content-between">
                                    <span class="text-muted">Nom</span>
                                    <span class="fw-semibold">{{ contacts_entreprise.nom }}</span>
                                </li>
                                <li class="list-group-item px-0 d-flex justify-content-between">
                                    <span class="text-muted">Prénom</span>
                                    <span class="fw-semibold">{{ contacts_entreprise.prenom }}</span>
                                </li>
                            </ul>
                        </div>
                        <div class="col-lg-6">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item px-0 d-flex justify-content-between">
                                    <span class="text-muted">Téléphone</span>
                                    <span class="fw-semibold">{{ contacts_entreprise.tel }}</span>
                                </li>
                                <li class="list-group-item px-0 d-flex justify-content-between">
                                    <span class="text-muted">E-mail</span>
                                    <span class="fw-semibold">
                    {% if contacts_entreprise.mail %}
                        <a href="mailto:{{ contacts_entreprise.mail }}">{{ contacts_entreprise.mail }}</a>
                    {% else %}
                        —
                    {% endif %}
                  </span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
{% endblock %}
