{# Thème Bootstrap 5 #}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{{ form_start(form, {
    attr: { class: 'needs-validation', novalidate: 'novalidate' }
}) }}

<div class="row g-3">
    {# Champs explicitement nommés si présents dans ton FormType #}
    {% if form.fonction is defined %}
        <div class="col-md-6">
            {{ form_row(form.fonction, {
                label: 'Fonction',
                row_attr: { class: 'mb-3' },
                attr: { placeholder: 'Ex. : Responsable RH' }
            }) }}
        </div>
    {% endif %}

    {% if form.nom is defined %}
        <div class="col-md-6">
            {{ form_row(form.nom, {
                label: 'Nom',
                row_attr: { class: 'mb-3' },
                attr: { placeholder: 'Ex. : Dupont' }
            }) }}
        </div>
    {% endif %}

    {% if form.prenom is defined %}
        <div class="col-md-6">
            {{ form_row(form.prenom, {
                label: 'Prénom',
                row_attr: { class: 'mb-3' },
                attr: { placeholder: 'Ex. : Claire' }
            }) }}
        </div>
    {% endif %}

    {% if form.tel is defined %}
        <div class="col-md-6">
            {{ form_row(form.tel, {
                label: 'Téléphone',
                row_attr: { class: 'mb-3' },
                attr: { placeholder: 'Ex. : 01 23 45 67 89' }
            }) }}
        </div>
    {% endif %}

    {% if form.mail is defined %}
        <div class="col-md-6">
            {{ form_row(form.mail, {
                label: 'E-mail',
                row_attr: { class: 'mb-3' },
                attr: { placeholder: 'Ex. : contact@entreprise.fr' }
            }) }}
        </div>
    {% endif %}

    {# Affiche tout champ restant (sauf _token) #}
    {% for child in form %}
        {% if child.vars.name not in ['_token', 'fonction', 'nom', 'prenom', 'tel', 'mail'] %}
            <div class="col-12">
                {{ form_row(child) }}
            </div>
        {% endif %}
    {% endfor %}
</div>

<div class="d-flex align-items-center gap-2 mt-4">
    <button class="btn btn-primary">
        <i class="bi bi-check2-circle me-1"></i> {{ button_label|default('Enregistrer') }}
    </button>
    <a href="{{ path('app_contacts_entreprise_index') }}" class="btn btn-outline-secondary">Annuler</a>
</div>

{{ form_end(form) }}

<script>
    // Validation Bootstrap
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>
