{% extends 'base.html.twig' %}

{% block title %}Nouveau contact – Entreprise{% endblock %}

{% block body %}
    {{ parent() }}

    <section class="section py-5">
        <div class="container" data-aos="fade-up" data-aos-delay="100">

            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="section-title m-0">
                    <h2 class="mb-1">Créer un contact</h2>
                    <p class="text-muted mb-0">Renseignez les informations de l’interlocuteur</p>
                </div>
                <a href="{{ path('app_contacts_entreprise_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Retour à la liste
                </a>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card shadow-sm border-0" data-aos="fade-up" data-aos-delay="150">
                        <div class="card-body p-4">
                            {{ include('contacts_entreprise/_form.html.twig', { button_label: 'Créer le contact' }) }}
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card shadow-sm border-0" data-aos="fade-up" data-aos-delay="200">
                        <div class="card-body">
                            <h5 class="fw-semibold mb-2"><i class="bi bi-info-circle me-2"></i>Astuce</h5>
                            <p class="text-muted mb-0">Ajoutez un e-mail valide pour faciliter la prise de contact.</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
{% endblock %}
