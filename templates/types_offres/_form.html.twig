{# Thème Bootstrap 5 #}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{{ form_start(form, {
    attr: { class: 'needs-validation', novalidate: 'novalidate' }
}) }}

<div class="row g-3">
    {% if form.libelle is defined %}
        <div class="col-md-8">
            {{ form_row(form.libelle, {
                label: 'Libellé',
                row_attr: { class: 'mb-3' },
                attr: { placeholder: 'Ex. : CDI, CDD, Stage' }
            }) }}
        </div>
    {% endif %}

    {# Afficher tout champ restant sauf _token et libelle #}
    {% for child in form %}
        {% if child.vars.name not in ['_token', 'libelle'] %}
            <div class="col-12">
                {{ form_row(child) }}
            </div>
        {% endif %}
    {% endfor %}
</div>

<div class="d-flex align-items-center gap-2 mt-4">
    <button class="btn btn-primary">
        <i class="bi bi-check2-circle me-1"></i> {{ button_label|default('Enregistrer') }}
    </button>
    <a href="{{ path('app_types_offres_index') }}" class="btn btn-outline-secondary">Annuler</a>
</div>

{{ form_end(form) }}

<script>
    // Validation Bootstrap
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');
        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>
