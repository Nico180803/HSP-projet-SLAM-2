{% extends 'base.html.twig' %}

{% block title %}TypesOffres index{% endblock %}

{% block body %}
    <h1>TypesOffres index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Libelle</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for types_offre in types_offres %}
            <tr>
                <td>{{ types_offre.id }}</td>
                <td>{{ types_offre.libelle }}</td>
                <td>
                    <a href="{{ path('app_types_offres_show', {'id': types_offre.id}) }}">show</a>
                    <a href="{{ path('app_types_offres_edit', {'id': types_offre.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_types_offres_new') }}">Create new</a>
    <br>
    <a href="{{ path('app_offres_index') }}">Retour</a>
{% endblock %}
