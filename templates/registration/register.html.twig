{% extends 'base.html.twig' %}

{% block title %}
    S'inscrire
{% endblock %}

{% block body %}

        {{ parent() }}


    <div class="container mt-5">


        <div class="card shadow p-4">
            <h2 class="mb-4">S'inscrire</h2>

            {{ form_errors(registrationForm) }}


            {{ form_start(registrationForm) }}

            <div class="row">
                <div class="col-md-6">
                    {{ form_row(registrationForm.role) }}
                </div>
            </div>

            <hr>

            <div class="row">
                <div class="col-md-6">
                    {{ form_row(registrationForm.nom) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(registrationForm.prenom) }}
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-6">
                    {{ form_row(registrationForm.email) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(registrationForm.plainPassword, {
                        label: 'Mot de passe'
                    }) }}
                </div>
            </div>

            {# Champs Étudiant #}
            <div id="etudiant-fields" class="role-group mt-4" style="display:none;">
                <h5>Informations Étudiant</h5>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(registrationForm.cv) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(registrationForm.formation) }}
                    </div>
                </div>
            </div>

            {# Champs Professeur #}
            <div id="prof-fields" class="role-group mt-4" style="display:none;">
                <h5>Informations Médecin</h5>
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(registrationForm.specialite) }}
                    </div>
                </div>
            </div>

            {# Champs Entreprise #}
            <div id="entreprise-fields" class="role-group mt-4" style="display:none;">
                <h5>Informations Entreprise</h5>
                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(registrationForm.nb_rueEntreprise) }}
                    </div>
                    <div class="col-md-8">
                        {{ form_row(registrationForm.rueEntreprise) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        {{ form_row(registrationForm.cpEntreprise) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(registrationForm.villeEntreprise) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(registrationForm.pays) }}
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">S'inscrire</button>
            </div>

            {{ form_end(registrationForm) }}
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const roleInputs = document.querySelectorAll('input[name$="[role]"]');
            const etudiantFields = document.getElementById('etudiant-fields');
            const profFields = document.getElementById('prof-fields');
            const entrepriseFields = document.getElementById('entreprise-fields');

            function updateFields(role) {
                etudiantFields.style.display = role === 'ROLE_USER' ? 'block' : 'none';
                profFields.style.display = role === 'ROLE_MEDECIN' ? 'block' : 'none';
                entrepriseFields.style.display = role === 'ROLE_ENTREPRISE' ? 'block' : 'none';
            }

            roleInputs.forEach(input => {
                input.addEventListener('change', function () {
                    updateFields(this.value);
                });

                if (input.checked) {
                    updateFields(input.value);
                }
            });
        });
    </script>
{% endblock %}
